{
  "name": "core-ir",
  "version": "1.3.0",
  "description": "Vendor-neutral canonical-IR message library for the intisy-ai AI-proxy ecosystem.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/core-ir.git"
  },
  "keywords": [
    "ir",
    "canonical-ir",
    "ai",
    "intisy",
    "core-ir"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:teavm": "node node_modules/@intisy-ai/api/scripts/teavm-build.mjs --java-dir . --module :teavm --out src/generated/core-ir.teavm.js",
    "build": "npm run build:teavm && tsc && node build.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "emit": "node node_modules/@intisy-ai/api/scripts/emit-dts.mjs --java-dir . --module :ir --module-dir ir --out src/generated"
  },
  "dependencies": {
    "@intisy-ai/api": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
